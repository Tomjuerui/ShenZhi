TZ=Asia/Shanghai
IMAGE_VERSION=v1.1.0-dev
APP_VERSION=1.0.0-SNAPSHOT
APP_PROFILE=prod
JAVA_OPTS=-Xms1024m -Xmx2048m -XX:+HeapDumpOnOutOfMemoryError

# PostgreSQL (pgvector)
# ADI_DB_PORT 是容器内端口（api 连接用），必须 5432
# ADI_DB_HOST_PORT 是映射到宿主机的端口，本机 5432 已被 langfuse-postgres 占用故改 15432
ADI_DB_HOST=postgres
ADI_DB_PORT=5432
ADI_DB_HOST_PORT=15432
ADI_DB_NAME=aideepin
ADI_DB_USERNAME=aideepin
ADI_DB_PASSWORD=Aideepin2026Pg

# Redis
ADI_REDIS_HOST=redis
ADI_REDIS_PORT=6379
ADI_REDIS_PASSWORD=

# Graph database: neo4j (browser at http://localhost:7474)
ADI_GRAPH_DATABASE=neo4j
ADI_NEO4J_HOST=neo4j
ADI_NEO4J_PORT=7687
ADI_NEO4J_USERNAME=neo4j
ADI_NEO4J_PASSWORD=Neo4j2026Graph
ADI_NEO4J_DATABASE=neo4j

# Mail (SMTP) - optional, leave placeholder if not needed
ADI_MAIL_ENABLE=false
ADI_MAIL_HOST=your-email-host
ADI_MAIL_USERNAME=your-email-username
ADI_MAIL_PASSWORD=your-email-password

# AES encryption key (16-char)
ADI_ENCRYPT_AES_KEY=b4f14d976031f561

# URLs: accessed through nginx on host port 80
ADI_HOST=localhost
ADI_FRONTEND_URL=http://localhost
ADI_BACKEND_URL=http://localhost/api

# Backend local file storage (inside container, named volume)
ADI_LOCAL_BASE_DATA_PATH=/data/aideepin
